[Settings]
# Preferred video resolution (e.g., 360p, 720p, 1080p, or best)
youtube_download_resolution = 360p

# Directory where downloaded files will be saved.
#   source - Save in the directory from which the file was called, or in the one over which Sent to was called (default)
#   [path] - Specify an absolute directory path
#   If left empty, it defaults to the Windows user's Videos folder (%USERPROFILE%\Videos).
youtube_download_directory = source

# What to download:
#   video+subtitles - Download the video and separate SRT subtitle files (default)
#   video           - Download the video only; no subtitle files
#   subtitles       - Download SRT subtitle files only; no video file
youtube_download_mode = video+subtitles

# How to handle files that already exist in the target directory:
#   zid-dir   - Create a subfolder named after the session ZID and place files there (default)
#   skip      - Log a skip message and proceed to the next URL
#   overwrite - Overwrite the existing files
youtube_download_duplicate_mode = zid-dir

# Subtitle languages to download:
#   original    - Detect the video's main language from metadata and download it
#   original,ru - Mix original detected language with specific language codes (e.g. Russian)
#   en,de,ru    - Comma-separated list of BCP-47 language codes
youtube_download_subtitle_languages = original

# Whether to fall back to auto-generated subtitles if manual ones are not available (true/false)
youtube_download_subtitle_auto_fallback = true

# Path to the ZID script used to generate Zettelkasten timestamps.
# Leave empty to fall back to local system time.
# Example: youtube_download_zid_script = U:\voothi\20241116203211-zid\zid.py
youtube_download_zid_script =

# Whether to automatically clean leading hyphens/dashes from subtitle lines (true/false)
youtube_download_clean_hyphens = false

# Whether to unbreak multi-line subtitles into single lines per block (true/false)
youtube_download_unbreak_lines = false

# Characters treated as hyphenation marks (default: -¬)
youtube_download_hyphenation_marks = -¬

# Comma-separated list of conjunctions that preserve trailing hyphens when unbreaking (e.g. for German composition split-hyphens)
youtube_download_compositional_conjunctions = und,oder,sowie,bzw,bis

# Whether to fix sentence-split artifacts from auto-translated subtitle tracks (true/false).
# Auto-translated tracks (e.g. Russian) sometimes start a block with a punctuation mark
# (e.g. ". Next sentence", ", continuation") or contain punctuation-only blocks (e.g. ".").
# When enabled, these are merged back into the previous block automatically.
youtube_download_fix_sentence_splits = false

# Whether to copy timestamps from the primary subtitle track onto all secondary tracks (true/false).
# Useful when downloading EN+RU auto-generated subtitles: YouTube generates each track independently,
# causing block-count differences and timestamp drift. Enabling this makes all secondary tracks
# share the primary track's exact timestamps so A/D navigation stays in sync.
# All secondary subtitle blocks are preserved; only timestamps are remapped to the nearest primary blocks.
youtube_download_sync_secondary_timestamps = false

# Companion audio track languages to download as audio-only MP4 files.
# When a YouTube video has dubbed audio tracks (e.g. a Russian dub), each specified language
# is downloaded as a separate audio-only MP4 file:
#   {ZID}-{title}.{lang}.mp4   (e.g. 20260527181921-google-bans-coding-with.ru.mp4)
# mpv auto-loads these files as external audio tracks when the video is opened,
# allowing you to switch between them with the companion audio hotkey (key: 1).
# Only languages with a genuine audio-only dubbed track in YouTube metadata are downloaded;
# if no such track exists for a language, the download is silently skipped.
#   Leave empty to disable (default)
#   en,ru  - Download English and Russian companion audio tracks
# youtube_download_companion_audio_languages = en,ru
youtube_download_companion_audio_languages =

# Whether to check for and install yt-dlp updates before starting downloads (true/false)
youtube_download_auto_update = true

# JavaScript runtime used by yt-dlp to solve signature/challenge scripts (e.g., node, deno, quickjs).
# Required to download multi-language dubbed audio and HLS/m3u8 streams.
# You can specify a custom path to the executable using RUNTIME:PATH syntax.
#   node       - Search for Node.js in the system PATH (default)
#   node:C:\Program Files\nodejs\node.exe - Specify a custom path to the Node.js executable
#   none       - Completely disable custom JS runtimes (yt-dlp will use its defaults/none)
# youtube_download_js_runtime = node
youtube_download_js_runtime = node

# How to save chapter metadata:
#   embedded - Embed chapters directly inside the video container (default)
#   separate - Save chapters to a separate .chapters.txt file
#   both     - Both embed chapters and save to a separate .chapters.txt file
youtube_download_chapters_mode = embedded

# Extract cookies from browser to bypass YouTube rate-limiting and HTTP 429 errors.
#   Leave empty to disable (default)
#   Supported values: chrome, firefox, edge, opera, safari, brave, vivaldi, etc.
# Note: Chrome on Windows 11 often blocks external processes via DPAPI App-Bound encryption.
# If you hit DPAPI errors, use firefox, edge, or specify a cookies file below.
# youtube_download_cookies_browser = chrome

# Alternatively, specify the path to a manually exported Netscape/Mozilla cookies file.
# Leave empty to disable (default). Specifying a cookies file is 100% immune to locks/DPAPI errors.
# youtube_download_cookies_file = 

# Console auto-close timeout in seconds (on successful runs in SendTo/pause mode).
# Set to 0 to close instantly; ignored on errors so they can be inspected.
# Default: 15
# youtube_download_auto_close_timeout_secs = 15 
