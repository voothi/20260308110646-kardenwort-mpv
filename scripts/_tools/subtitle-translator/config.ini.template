[Settings]
# Path to the ZID script used to generate Zettelkasten timestamps.
# Leave empty to fall back to local system time.
subtitle_translator_zid_script = U:\voothi\20241116203211-zid\zid.py

# Comma-separated list of target BCP-47 language codes to translate to.
# E.g., ru,de
subtitle_translator_target_languages = ru,de

# Default source language code if not detected from the input filename.
subtitle_translator_source_language = en

# Active translation provider: google (currently implemented), deepl (currently implemented), or ollama (currently implemented)
subtitle_translator_provider = google

# How to handle files that already exist in the target directory:
#   skip      - Suppress translation and keep the existing file (default)
#   overwrite - Overwrite the existing file
#   archive   - Move the existing file to a subfolder named after the session ZID, then create a new one
subtitle_translator_duplicate_mode = skip

# Add a generated ZID to files that do not already have one.
# When true, the source is renamed to <zid>-<title>.<source_lang>.<ext>
# before translating, and outputs use the same ZID.
# When false, the source filename is left unchanged and outputs omit
# the generated ZID. Existing source ZIDs are always preserved.
subtitle_translator_rename_source_with_zid = false

# When enabled, add the same ZID to a related media file in the same folder.
# Supports common audio/video files such as mp3, mp4, m4a, wav, flac, mkv, and webm.
# The media file should share the subtitle clean title, for example:
#   movie.en.srt -> movie.mp3 or movie.mp4
# If the media file already has a ZID, it is left unchanged.
# Requires subtitle_translator_rename_source_with_zid=true when the source
# subtitle does not already have a ZID.
subtitle_translator_rename_related_media_with_zid = false

# --- Google Translate Settings ---
# Google Translate API base URL (uses free V1 API client=gtx)
google_api_url = https://translate.googleapis.com/translate_a/single

# --- DeepL Settings ---
# DeepL Auth Key / API Key
deepl_api_key = 
# DeepL API URL
deepl_api_url = https://api-free.deepl.com/v2/translate
# Formality setting: default, formal, or informal
deepl_formality = default

# --- Ollama Settings ---
# Ollama base API URL (e.g. http://localhost:11434/api/generate)
ollama_api_url = http://localhost:11434/api/generate
# Model name to use
ollama_model = llama3
# Prompt format for translation. Must contain {source_lang} and {target_lang} placeholders.
ollama_prompt = Translate the following text from {source_lang} to {target_lang}. Stick strictly to {target_lang} (Russian) and do not use words from any other language. Output ONLY the raw translation, without any explanations, preamble, introductory remarks, or formatting. Preserve the line breaks.
# Unique prompt addition (salt) template on retry attempts to help models recover.
# Put the repeating portion in square brackets, e.g., Make it [MUCH] better! or Сделай [НАМНОГО] лучше!.
# Example: Make it [much] better -> Make it much, much better (on attempt 3).
# Add validation feedback (previous retry error) to prompt on retry attempts.
# Set to "false" to disable.
ollama_prompt_feedback = false
# Leave empty or set to "false" to disable.
ollama_prompt_salt = false
# Use structured JSON input/output for Ollama chunk translation.
# Useful for models that follow structured output; very small models (like gemma3:1b)
# may still return the wrong item count, which is handled by retries and rescue.
# Set to "false" to disable.
# If a validated chunk still fails after all retries, the translator automatically
# rescues that chunk line-by-line with Ollama JSON disabled for the rescue calls only.
ollama_json_format = false
# Schema format to use for structured JSON: dict_of_strings (recommended, object with array), array_of_strings (simple list) or array_of_objects (legacy id/text format).
ollama_json_schema = dict_of_strings
# JSON prompt format for translation. Must contain {source_lang} and {target_lang} placeholders.
ollama_json_prompt = Translate the JSON array of strings under the 'source' key from {source_lang} to {target_lang}. Output ONLY a JSON object with a single 'translations' key containing the translated JSON array of strings, without any markdown formatting, code block markers, explanations, or preamble.
# Template for error feedback on retries. Must contain the {last_error} placeholder.
ollama_prompt_feedback_template = [Feedback from previous attempt: {last_error}]

# --- Chunk Validation Settings ---
# Translate and validate subtitles in chunks of this size (e.g. 5).
# Set to 0 to disable validation chunking and use standard batching.
# When subtitle_translator_merge_lines=true, this counts merged translation units,
# not original subtitle blocks; use 1 for small models to translate one merged unit
# at a time while still preserving context inside that unit.
subtitle_translator_chunk_size = 5

# Number of times to retry translating a chunk if validation fails.
subtitle_translator_max_retries = 3

# Show compact model response previews for failed validation attempts.
# Set to "true" when debugging model output; keep "false" for cleaner SendTo output.
subtitle_translator_verbose_validation_errors = false

# Enable approximate word count validation (helps detect model hallucinations/skips).
subtitle_translator_word_count_check = false

# Word count ratio tolerance (min, max ratio of translated words / source words).
subtitle_translator_word_count_min_ratio = 0.25
subtitle_translator_word_count_max_ratio = 3.5

# When enabled, if chunk validation fails after all retries, the completed chunks
# are saved to the target file. Failed chunks produce blank subtitle text (timecodes
# are preserved, text is empty). Respects subtitle_translator_duplicate_mode
# (skip/overwrite/archive) when a target file already exists.
subtitle_translator_save_partial_on_failure = false

# Remove custom artifacts from subtitle text after translation.
# Semicolon-separated rules; prefixes: re:<regex>, glob:<wildcard>, or plain text.
# Example: **;re:\s+\[noise\]$;glob:[[]draft[]]
subtitle_translator_clean_patterns = **

# Merge continuous subtitle lines to translate them together as a single context block.
# The split back to subtitle blocks is controlled by subtitle_translator_merge_split_mode.
# Two adjacent blocks are merged when:
#   - The gap between their timestamps is less than subtitle_translator_merge_max_gap_ms ms.
#   - The preceding block text does NOT end with sentence-ending punctuation (. ? ! :).
# Set to "true" to enable context-aware mode; set to "false" for strict line-by-line mode.
subtitle_translator_merge_lines = false

# How to split translated merge groups back into subtitle blocks:
#   marker       - exact split markers are inserted and must survive translation (default)
#   proportional - old heuristic split by original text lengths; less strict, less exact
subtitle_translator_merge_split_mode = marker

# Maximum gap in milliseconds between subtitle timestamps to consider them continuous for merging.
subtitle_translator_merge_max_gap_ms = 1000

# Console auto-close timeout in seconds (on successful runs in SendTo/pause mode).
# Set to 0 to close instantly; leave empty to disable auto-close.
# Ignored on errors so they can be inspected.
# Default: 15
# youtube_download_auto_close_timeout_secs = 15
