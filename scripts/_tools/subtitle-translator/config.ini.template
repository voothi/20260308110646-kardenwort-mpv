[Settings]
# Path to the ZID script used to generate Zettelkasten timestamps.
# Leave empty to fall back to local system time.
subtitle_translator_zid_script = U:\voothi\20241116203211-zid\zid.py

# Comma-separated list of target BCP-47 language codes to translate to.
# E.g., ru,de
subtitle_translator_target_languages = ru,de

# Default source language code if not detected from the input filename.
subtitle_translator_source_language = en

# Active translation provider: google (currently implemented), deepl (currently implemented), or ollama (currently implemented)
subtitle_translator_provider = google

# How to handle files that already exist in the target directory:
#   skip      - Suppress translation and keep the existing file (default)
#   overwrite - Overwrite the existing file
#   archive   - Move the existing file to a subfolder named after the session ZID, then create a new one
subtitle_translator_duplicate_mode = skip

# --- Google Translate Settings ---
# Google Translate API base URL (uses free V1 API client=gtx)
google_api_url = https://translate.googleapis.com/translate_a/single

# --- DeepL Settings ---
# DeepL Auth Key / API Key
deepl_api_key = 
# DeepL API URL
deepl_api_url = https://api-free.deepl.com/v2/translate
# Formality setting: default, formal, or informal
deepl_formality = default

# --- Ollama Settings ---
# Ollama base API URL (e.g. http://localhost:11434/api/generate)
ollama_api_url = http://localhost:11434/api/generate
# Model name to use
ollama_model = llama3
# Prompt format for translation. Must contain {source_lang} and {target_lang} placeholders.
ollama_prompt = Translate the following text from {source_lang} to {target_lang}. Output ONLY the raw translation, without any explanations, preamble, introductory remarks, or formatting. Preserve the line breaks.

# --- Chunk Validation Settings ---
# Translate and validate subtitles in chunks of this size (e.g. 5).
# Set to 0 to disable validation chunking and use standard batching.
subtitle_translator_chunk_size = 5

# Number of times to retry translating a chunk if validation fails.
subtitle_translator_max_retries = 3

# Enable approximate word count validation (helps detect model hallucinations/skips).
subtitle_translator_word_count_check = false

# Word count ratio tolerance (min, max ratio of translated words / source words).
subtitle_translator_word_count_min_ratio = 0.25
subtitle_translator_word_count_max_ratio = 3.5

# When enabled, if chunk validation fails after all retries, the completed chunks
# are saved to the target file. Failed chunks produce blank subtitle text (timecodes
# are preserved, text is empty). Respects subtitle_translator_duplicate_mode
# (skip/overwrite/archive) when a target file already exists.
subtitle_translator_save_partial_on_failure = false
