[paths]
# ============================================================================
# All paths can be absolute or relative to the sub-tts directory.
# Use forward slashes (/) for paths, even on Windows.
# ============================================================================

# Full path to the root of the piper-tts project.
# This directory must contain piper_tts.py and a valid config.ini.
# Example: U:/voothi/20241206010110-piper-tts
piper_tts_root = U:/voothi/20241206010110-piper-tts

# Full path to the ffmpeg executable.
# Example: C:/Tools/ffmpeg/bin/ffmpeg.exe
ffmpeg_executable = C:/Tools/ffmpeg/ffmpeg-7.1-essentials_build/bin/ffmpeg.exe

# Full path to the zid.py script (used for ZID-based duplicate handling).
# Leave empty to use datetime.now() as fallback.
# Example: U:/voothi/20241116203211-zid/zid.py
zid_script = U:/voothi/20241116203211-zid/zid.py


[tts_settings]
# The default language to use when no language postfix is found in the filename.
# Must match a language code supported by the Piper TTS config.ini (e.g., en, de, ru).
default_lang = en

# How to handle output filename duplicates.
# zid-dir  : route to a new ZID-named subdirectory (recommended)
# skip     : skip conversion if the output file already exists
# overwrite: overwrite the existing output file
duplicate_mode = zid-dir

# Keep the language postfix in the output MP4 filename (e.g. video.de.mp4 instead of video.mp4)
# in accordance with the postfix in the SRT file.
# Note: config.ini (the live config) may differ — check it for the active setting.
keep_lang_postfix = false


# Prioritized list of languages (comma-separated) to treat as the primary/timeline source of truth.
# When processing multiple files, the file matching the highest priority language present
# will be processed first to establish the canonical timeline.
# Supports regional/locale suffixes (e.g. 'en_US' or 'en-US' will match 'en').
# Fallback: defaults to the 'default_lang' setting if empty.
primary_languages = en, de


# Defines what dictates the final timeline (The Source of Truth).
# 'primary_subtitle' : The original SRT timing is the absolute truth. The generated audio
#                      is adjusted (sped up) to fit into the original subtitle slots.
# 'primary_audio'    : The first track's native TTS audio is the absolute truth. The 
#                      timeline is rebuilt around it, and any secondary translated
#                      tracks are adjusted (sped up) to fit this new timeline.
timeline_source = primary_subtitle

# (Only applies when timeline_source = primary_subtitle)
# If the audio STILL overflows its subtitle slot even after being sped up,
# shift the subsequent subtitles later in time to make room and avoid overlap.
# In this case, the subtitle yields slightly to the audio.
shift_subtitles_on_overflow = false

# Optional VAD-like pause compression before tempo adjustment.
vad_silence_compression = false
vad_max_silence_seconds = 0.15

# Prefer FFmpeg's rubberband filter for better pitch-preserving speed changes
# when the local FFmpeg build supports it; otherwise the tool falls back to atempo.
high_quality_time_stretch = false

# Subtitle Edit permits up to 1000ms of the gap before the next subtitle to avoid
# unnecessary speed-up when there is room after the cue.
max_extra_gap_ms = 1000

# Cap automatic speed-up. Increase if you prefer strict subtitle fit over
# natural-sounding speech.
max_speed_factor = 2.0


# Console auto-close timeout in seconds (on successful runs in SendTo/pause mode).
# Set to 0 to close instantly; ignored on errors so they can be inspected.
# Default: 15
# auto_close_timeout_secs = 15


[lang_aliases]
# ============================================================================
# Optional: Map subtitle filename postfixes to Piper language codes.
# Format: <postfix> = <language_code>
# These override the built-in alias table.
# The built-in table already handles: eng -> en, ger -> de, rus -> ru
# ============================================================================
# eng = en
# ger = de
# rus = ru
# ukr = uk
