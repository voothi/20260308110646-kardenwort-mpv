# =========================================================================
# Kardenwort MPV - .gitignore
# =========================================================================

# --- System & IDE ---
.history/
# .claude/
# .cline/
# .roo/
# .opencode/
*.code-workspace

# --- Python & Build ---
__pycache__/
*.pyc
.pytest_cache/

# --- Persistent State ---
resume-session.state
resume_session.state

# --- Temporary & Development Artifacts ---
scratch/
# *.txt
# *.patch
# *.log
# *.bak
# *.old
# *temp*
# test*.py
# test*.lua
# old.lua
# parsed_subs*
tests/mpv_last_run.log
pytest_out.log
.pytest_tmp/
dist/
scripts/_tools/sub-viewer/logs/mpv_sub_viewer.log
# scripts/_tools/sub-tts/config.ini
scripts/_tools/sub-tts/logs/
scripts/_tools/sub-tts/__pycache__/

# --- Specific Legacy Exclusions ---
# scripts/*_old*.lua
# scripts/test_osd.lua
# scripts/old_copy_sub.lua
# scripts/lls_core_good*.lua
# tests/fixtures/20260502165659-test-fixture.tsv

# --- User Settings (Optional) ---
# anki-mapping.ini is versioned, but users can untrack it if needed.
# !anki-mapping.ini

# --- Generated Sub Viewer Media ---
# scripts/_tools/sub-viewer/black.mp4
mpv_start_test.log
mpv_success_test.log
mpv_test_launch.log
docs/assets/
.tmp_pytest_subviewer/
